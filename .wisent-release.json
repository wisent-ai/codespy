{
  "schema_version": 1,
  "product": "codespy",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*$"
  },
  "platforms": {
    "source": {
      "runner_platform": "linux-amd64",
      "quality": [],
      "build": {
        "argv": ["stado", "product", "source-bundle"]
      },
      "stage": {
        "release/source-bundle.tar": "release/source-bundle.tar"
      }
    }
  },
  "promotion": {
    "channels": [
      "stable"
    ],
    "reconcile": false
  },
  "inputs": {},
  "deliveries": []
}
